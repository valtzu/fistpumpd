FROM docker.io/library/golang:1.24-bookworm
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends swtpm swtpm-tools tpm2-tools tpm2-abrmd libtss2-tcti-tabrmd0 dbus gnupg openssl ca-certificates >/dev/null 2>&1; go version; tpm2_createek --version | head -1
